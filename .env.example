# ── AI assistant (optional) ────────────────────────────────────────────────
# Explain / fix / ask / autocomplete in the playground and lessons.
# Leave ANTHROPIC_API_KEY empty to hide AI features.
ANTHROPIC_API_KEY=

# Route through an Anthropic-compatible gateway instead of Anthropic directly.
# Leave unset to call Anthropic.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com/anthropic

# 'x-api-key' (Anthropic default) or 'bearer' for gateways that authenticate
# with an Authorization: Bearer header.
# ANTHROPIC_AUTH_SCHEME=bearer

# Model id. Use the gateway's alias for custom models, e.g. CLAUDE_MODEL=coder.
# Native ids (claude-*) also get refusal fallbacks, effort control and prompt
# caching; gateway aliases get a plain Messages request.
CLAUDE_MODEL=claude-opus-5-5

# Optional faster model for latency-sensitive calls (editor autocomplete).
# Defaults to CLAUDE_MODEL.
# CLAUDE_FAST_MODEL=

# Max concurrent AI calls for the whole server (default 5).
AI_MAX_CONCURRENCY=5

# ── Voice input / transcription (optional) ────────────────────────────────
# Any Whisper-compatible speech-to-text endpoint. Without a key the mic buttons
# fall back to the browser's built-in speech recognition (Chrome, Edge, Safari).
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-1

# ── Live database mode ─────────────────────────────────────────────────────
# Live mode only allows localhost databases by default. Set to "true" to allow remote hosts.
ALLOW_REMOTE_DB=false
